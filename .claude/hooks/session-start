#!/usr/bin/env bash
# SessionStart hook: injects the using-superpowers skill into every Claude Code
# session so the vendored Superpowers skills in .claude/skills are used proactively.
# Adapted from obra/superpowers hooks/session-start (MIT), Claude Code output only.
# Avoids external commands and subshells: SessionStart can run with an empty PATH.

set -euo pipefail

case "$0" in
  */*|*\\*) SCRIPT_DIR="${0%[/\\]*}" ;;
  *) SCRIPT_DIR="." ;;
esac

skill_md="${SCRIPT_DIR}/../skills/using-superpowers/SKILL.md"
content="Error reading using-superpowers skill"
if [ -r "$skill_md" ]; then
  IFS= read -r -d '' content < "$skill_md" || true
  while [[ $content == *$'\n' ]]; do content="${content%$'\n'}"; done
fi

content="${content//\\/\\\\}"
content="${content//\"/\\\"}"
content="${content//$'\n'/\\n}"
content="${content//$'\r'/\\r}"
content="${content//$'\t'/\\t}"

context="<EXTREMELY_IMPORTANT>\nYou have superpowers.\n\n**Below is the full content of your 'using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${content}\n</EXTREMELY_IMPORTANT>"

trap '' PIPE
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context" 2>/dev/null || true
exit 0
